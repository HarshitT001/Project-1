# --- Existing ---
DATABASE_URL=your_postgres_connection_string
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRE=7d
PORT=5000

# Set this to your live frontend URL(s), comma-separated if more than one
# e.g. https://mealmap.vercel.app,https://www.yourdomain.com
CLIENT_URL=https://your-frontend-domain.com

# --- New — required for the login cookie to work correctly in production ---
# Without this, generateToken.js can't tell it's running on Railway and the
# cookie won't be marked secure/cross-site, so the browser will drop it.
NODE_ENV=production

# --- New — optional, for real SMS OTP delivery ---
# Leave these blank to keep using the console-log fallback (OTP is printed
# in Railway's logs and returned in the API response while NODE_ENV isn't
# "production"). Fill them in + `npm install twilio` once you have a
# Twilio account to send real text messages.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
