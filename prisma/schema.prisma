generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  mealPlans MealPlan[]
}

model MealPlan {
  id        Int      @id @default(autoincrement())
  title     String
  calories  Int
  createdAt DateTime @default(now())

  userId    Int
  user      User @relation(fields: [userId], references: [id])
}